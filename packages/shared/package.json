{
  "name": "@telegram-star/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/config": {
      "types": "./dist/contracts/config.d.ts",
      "import": "./dist/contracts/config.js"
    },
    "./contracts/clients": {
      "types": "./dist/contracts/clients.d.ts",
      "import": "./dist/contracts/clients.js"
    },
    "./contracts/chats": {
      "types": "./dist/contracts/chats.d.ts",
      "import": "./dist/contracts/chats.js"
    },
    "./contracts/filters": {
      "types": "./dist/contracts/filters.d.ts",
      "import": "./dist/contracts/filters.js"
    },
    "./contracts/forward-targets": {
      "types": "./dist/contracts/forward-targets.d.ts",
      "import": "./dist/contracts/forward-targets.js"
    },
    "./contracts/health": {
      "types": "./dist/contracts/health.d.ts",
      "import": "./dist/contracts/health.js"
    },
    "./contracts/messages": {
      "types": "./dist/contracts/messages.d.ts",
      "import": "./dist/contracts/messages.js"
    },
    "./browser-storage": {
      "types": "./dist/browser-storage.d.ts",
      "import": "./dist/browser-storage.js"
    }
