{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram Star Mobile",
  "version": "0.1.0",
  "identifier": "com.telegramstar.mobile",
  "build": {
    "beforeDevCommand": "pnpm --filter @telegram-star/mobile dev:shell",
    "devUrl": "http://127.0.0.1:5182",
    "beforeBuildCommand": "pnpm --filter @telegram-star/mobile build:shell",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Telegram Star",
        "width": 430,
        "height": 932,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../../web/public/icons/icon-192.png",
      "../../web/public/icons/icon-512.png"
    ]
  }
}
