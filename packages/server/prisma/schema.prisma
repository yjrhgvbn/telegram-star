generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Filter {
  id        Int         @id @default(autoincrement())
  name      String
  conditions String
  enabled   Boolean     @default(true)
  autoLocateUnreadNearRead Boolean @default(true) @map("auto_locate_unread_near_read")
  createdAt String      @map("created_at")
  updatedAt String      @map("updated_at")
  messages  Message[]
  forwardTargets ForwardTarget[] @relation("FilterToForwardTarget")

  @@map("filters")
}

model Message {
  id                Int      @id @default(autoincrement())
  telegramMessageId Int      @map("telegram_message_id")
  chatId            String   @map("chat_id")
  chatTitle         String   @default("") @map("chat_title")
  senderName        String   @default("") @map("sender_name")
  senderId          String   @default("") @map("sender_id")
  content           String   @default("")
  messageDate       String   @map("message_date")
  telegramLink      String   @default("") @map("telegram_link")
  isRead            Boolean  @default(false) @map("is_read")
  matchedFilterId   Int?     @map("matched_filter_id")
  matchedKeyword    String?  @map("matched_keyword")
  createdAt         String   @map("created_at")
  matchedFilter     Filter?  @relation(fields: [matchedFilterId], references: [id], onDelete: SetNull)

  // --- 媒体元信息 ---
  mediaType         String?  @map("media_type")           // "photo"|"video"|"sticker"|"document"|"voice"|"audio"|"gif"|"videoNote"|"contact"|"geo"|"poll"
  mediaFileName     String?  @map("media_file_name")      // 原始文件名
  mediaFileSize     Int?     @map("media_file_size")      // 文件大小 (bytes)
  mediaMimeType     String?  @map("media_mime_type")      // MIME 类型
  mediaDuration     Int?     @map("media_duration")       // 音视频时长 (秒)
  mediaThumbBase64  String?  @map("media_thumb_base64")   // Stripped thumbnail base64
  mediaExtra        String?  @map("media_extra")          // JSON 扩展字段 (宽高/联系人等)

  @@index([messageDate, telegramMessageId])
  @@index([matchedFilterId, isRead, messageDate])
  @@index([isRead, messageDate])

  @@map("messages")
}

model ReadSyncLog {
  id                Int     @id @default(autoincrement())
  level             String
  source            String
  action            String
  message           String
  chatId            String? @map("chat_id")
  telegramMessageId Int?    @map("telegram_message_id")
  rowId             Int?    @map("row_id")
  detailsJson       String? @map("details_json")
  createdAt         String  @map("created_at")

  @@index([createdAt])
  @@index([source])
  @@map("read_sync_logs")
}

model ForwardTarget {
  id          Int      @id @default(autoincrement())
  name        String
  appriseUrl  String   @map("apprise_url")
  enabled     Boolean  @default(true)
  createdAt   String   @map("created_at")
  updatedAt   String   @map("updated_at")

  filters     Filter[] @relation("FilterToForwardTarget")

  @@map("forward_targets")
}
