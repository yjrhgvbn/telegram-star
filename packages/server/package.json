{
  "name": "@telegram-star/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsdown --watch --on-success \"node dist/index.js\"",
    "build": "prisma generate && tsdown",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node dist/db/deploy.js",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "telegram": "^2.26.0",
    "input": "^1.0.1",
    "@prisma/adapter-libsql": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^16.4.0",
    "big-integer": "^1.6.52",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "tsdown": "^0.15.5",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
