# Telegram API (optional; if empty, configure it in the Web UI after startup)
# Get credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=file:./data/telegram-star.db
DB_PATH=./data/telegram-star.db

# Session persistence
SESSION_PATH=./data/session.txt

# CORS (use * for local Web/Tauri/Mobile development; restrict it in production)
CORS_ORIGIN=*

# API Proxy Target for Web Frontend (development only)
API_PROXY_TARGET=http://localhost:3000
